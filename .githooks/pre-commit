#!/usr/bin/env bash
#
# Pre-commit hook: enforce the same rustfmt and clippy gates CI runs, so
# formatting/lint failures are caught locally instead of on the PR.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Skip in a pinch with `git commit --no-verify`.

set -euo pipefail

# Only run when Rust sources or the manifest are staged; doc-only commits
# shouldn't pay the clippy cost.
if ! git diff --cached --name-only --diff-filter=ACMR \
        | grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$'; then
    exit 0
fi

echo "pre-commit: cargo fmt --all -- --check"
if ! cargo fmt --all -- --check; then
    echo
    echo "✗ Formatting issues found. Run 'cargo fmt --all' and re-stage." >&2
    exit 1
fi

echo "pre-commit: cargo clippy --workspace --all-targets -- -D warnings"
if ! cargo clippy --workspace --all-targets -- -D warnings; then
    echo
    echo "✗ Clippy reported warnings (denied). Fix them and re-stage." >&2
    exit 1
fi

echo "pre-commit: ok"
